{
  "$schemas": [
    "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json"
  ],
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/DevTKSS.Uno.Samples.MvuxGallery.csproj"
          ]
        }
      ],
      "output": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "articles/**.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "api/Uno.Resizetizer*.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "markdownEngineProperties": {
      "markdigExtensions": [
        "yaml",
        "definitionlists",
        "diagrams",
        "bootstrap",
        "globalization",
        "advanced",
        "abbreviations",
        "autolinks",
        "alertblocks",
        "emoji",
        "footnotes",
        "gridtables",
        "media"
      ]
    },
    "globalMetadata": {
      "_appTitle": "DevTKSS Sample Apps & Tutorials for Uno Platform Development",
      "_appName": "DevTKSS.Uno.SampleApps",
      "_enableSearch": true,
      "pdf": false
    }
  }
}